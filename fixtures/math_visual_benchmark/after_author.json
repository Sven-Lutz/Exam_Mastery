{
  "claims": [
    {
      "id": "K1",
      "kind": "official",
      "source_refs": [
        "src-9b0c7b56ccbb:p1"
      ],
      "text": "Under fixed pretax profit P, effective tax rate t and shares N>0, EPS equals P(1-t)/N."
    },
    {
      "id": "K2",
      "kind": "inference",
      "source_refs": [
        "src-9b0c7b56ccbb:p1"
      ],
      "text": "A five-percentage-point tax rate decrease yields a different relative EPS percentage increase."
    }
  ],
  "limitations": [
    "This synthetic example does not model financial-reporting adjustments, dilutive securities or legal tax provisions."
  ],
