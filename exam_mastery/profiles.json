     "sensitivity"
    ],
    "compare": [
     "comparison"
    ]
   },
   "validators": [
    "numeric_checks",
    "derivation_check"
   ],
   "claim_types": [
    "EMPIRICAL"
   ]
  },
  {
   "id": "conceptual-interpretative",
   "operations": [
    "interpret",
    "compare",
    "argue",
    "critique",
    "synthesize"
   ],
   "methods": [
