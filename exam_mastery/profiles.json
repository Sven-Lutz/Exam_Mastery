{
 "schema": "skill-pack-registry-v2",
 "rule": "Choose skills by reasoning operations and evidence requirements, never by a closed list of course names. Unknown operations are allowed and must be documented as capability gaps.",
 "packs": [
  {
   "id": "formal-mathematics",
   "operations": [
    "derive",
    "prove",
    "calculate",
    "optimize"
   ],
   "methods": [
    "explicit assumptions and domains",
    "proof obligations and boundary cases",
    "symbolic and numerical cross-checks"
   ],
   "quality_gate": "Each conclusion follows from named premises; no hidden division by zero or missing edge cases.",
   "signals": {
    "prove": "\\bbeweis|\\bprove|\\bproof|show that|zeigen sie,? dass",
    "derive": "herleit|\\bderive|aufstellen|set up the (?:equation|model)|leite[nt]?\\b.*\\bher\\b",
    "calculate": "berechn|ausrechn|durchrechn|\\bcompute|\\bcalculate|\\blösen\\b|\\bsolve\\b|determine the (?:value|ph|speed|force|probability)|use conservation|apply [A-Z][a-z]+\\'s (?:law|theorem)|\\bsize a\\b",
    "optimize": "optimal|maximier|minimier|optimi"
   },
   "requires": {
    "prove": [
     "theorem_statement",
     "proof",
     "counterexample"
    ],
    "derive": [
     "derivation"
    ],
    "calculate": [
     "worked_example",
     "practice_task"
    ],
    "optimize": [
     "worked_example"
    ]
   },
   "validators": [
    "argument_graph",
    "derivation_check",
    "numeric_checks"
   ],
   "claim_types": [
    "MATHEMATICAL"
   ]
  },
  {
   "id": "legal-reasoning",
   "operations": [
    "subsume",
    "interpret",
    "apply-law",
    "argue"
   ],
   "methods": [
    "norm hierarchy and as-of-date",
    "elements and legal consequences",
    "fact-to-element subsumption",
    "competing interpretations",
    "case citations and exceptions"
   ],
   "quality_gate": "No legal claim without precise relevant authority and effective-date review.",
   "signals": {
    "subsume": "subsumi|tatbestand|anspruch(?:sgrundlage)?\\b|advise (?:the |a )?(?:claimant|defendant|client)|whether (?:a )?(?:valid )?contract|\\bliab(?:le|ility)\\b|negligence|enforceable|wirksam(?:keit)?\\b",
    "apply-law": "§\\s*\\d|\\bart\\.\\s*\\d|\\bgesetz(?:es)?\\b|\\bverordnung|\\bstatute|\\bact \\d{4}|case law|precedent|common law",
    "interpret": "\\bauslegen|\\bauslegung|statutory interpretation"
   },
   "requires": {
    "subsume": [
     "case_solution",
     "norm_text"
    ],
    "apply-law": [
     "norm_text"
    ],
    "interpret": [
     "competing_views"
    ]
   },
   "validators": [
    "evidence_registry"
   ],
   "claim_types": [
    "NORMATIVE_LEGAL"
   ]
  },
  {
   "id": "clinical-reasoning",
   "operations": [
    "diagnose",
    "treat",
    "triage",
    "interpret-evidence"
   ],
   "methods": [
    "differential diagnosis",
    "guideline and evidence levels",
    "red flags, uncertainty and escalation",
    "independent medical review"
   ],
   "quality_gate": "Never issue clinical-ready materials without verified current medical sources and qualified review.",
   "signals": {
    "diagnose": "diagnos|differential|differentiate .+ from|red flags?|warnzeichen",
    "treat": "therapi|behandl|\\btreat|\\bmanage(?:ment)?\\b(?!.*(?:project|software))|prescrib|first-line|dosing|dosis|pflege|nursing care|contraindication|kontraindikation|mechanism of action|wirkmechanismus",
    "interpret-evidence": "sensitivit(?:y|ät) (?:and|und) spe[cz]ifi|spezifität|specificity|diagnostic accuracy|leitlinie|guideline|interpret (?:an? )?(?:ecg|ekg|arterial blood gas|blood gas|lab)|randomi[sz]ed controlled"
   },
   "requires": {
    "diagnose": [
     "case_solution",
     "uncertainty_note"
    ],
    "treat": [
     "guideline_reference",
     "uncertainty_note"
    ],
    "interpret-evidence": [
     "worked_example"
    ]
   },
   "validators": [
    "evidence_registry"
   ],
   "claim_types": [
    "CLINICAL"
   ]
  },
  {
   "id": "computational-reasoning",
   "operations": [
    "implement",
    "debug",
    "test",
    "analyze-complexity"
   ],
   "methods": [
    "executable examples and unit tests",
    "complexity and invariant proofs",
    "negative cases and error-handling",
    "reproducible environments"
   ],
   "quality_gate": "Run tests on all claimed executable code; distinguish implementation failure from methodological failure.",
   "signals": {
    "implement": "implementier|programmier|\\bcode\\b|pseudocode|\\balgorithm|write (?:a )?function|\\bimplement\\b|refactor|\\bdebug|database schema|\\buml\\b|pull request",
    "analyze-complexity": "laufzeit|komplexität|complexity|runtime|big-?o\\b",
    "test": "unit[- ]?tests?|test cases?|teste(?:n sie)? (?:den|die) (?:code|funktion)|mocks?\\b"
   },
   "requires": {
    "implement": [
     "algorithm",
     "worked_example"
    ],
    "analyze-complexity": [
     "complexity_statement"
    ],
    "test": [
     "practice_task"
    ]
   },
   "validators": [
    "numeric_checks"
   ],
   "claim_types": [
    "ALGORITHMIC"
   ]
  },
  {
   "id": "empirical-research",
   "operations": [
    "infer",
    "estimate",
    "analyze-data",
    "critique-study"
   ],
   "methods": [
    "design and population",
    "sampling and biases",
