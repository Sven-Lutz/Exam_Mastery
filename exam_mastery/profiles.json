   "quality_gate": "No fabricated author intent, quotation, historical claims or empirical evidence.",
   "signals": {
    "interpret": "deuten|interpretier|einordn|\\binterpret\\b(?! (?:an? )?(?:ecg|ekg|arterial|blood|lab))|close-read|imagery",
    "argue": "begründ|argumentier|\\bargue|\\bjustify|\\bevaluate\\b|\\bassess\\b|\\bdiscuss\\b|erörter|beurteil|objections?|einwände",
    "critique": "kritisch|critical(?:ly)?\\b|limitations?|grenzen (?:der|des|von)|weakness",
    "compare": "unterscheid|vergleich|abgrenz|\\bcompare\\b|\\bcontrast\\b|distinguish|voice leading|parallel fifths"
   },
   "requires": {
    "interpret": [
