   "signals": {
    "infer": "schätz|inferenz|signifikan|\\bestimate|hypothesis test|t-test|confidence interval|konfidenz|p-value|regression|bayes|effect size|effektstärke|posterior",
    "analyze-data": "messdaten|daten(?:satz|analyse)|dataset|analy[sz]e (?:the )?data|experimental data|residual|concentration data|population density",
    "critique-study": "studie|studiendesign|\\bbias\\b|internal validity|replication|randomi[sz]ed"
   },
   "requires": {
    "infer": [
     "uncertainty_note",
     "worked_example"
    ],
    "analyze-data": [
     "worked_example"
    ],
    "critique-study": [
     "competing_views"
    ]
   },
   "validators": [
    "evidence_registry"
   ],
   "claim_types": [
    "EMPIRICAL",
    "BENCHMARK"
   ]
  },
  {
   "id": "economic-modeling",
